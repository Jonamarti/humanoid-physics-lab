{
  "name": "humanoid-physics-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic browser-based humanoid physics laboratory",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sim": "vite build --ssr scripts/sim.ts --outDir dist-cli --configLoader runner --logLevel warn && node dist-cli/sim.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.15.30",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.1.12",
    "vitest": "3.2.4",
    "@types/three": "0.178.1"
  },
  "dependencies": {
    "@mujoco/mujoco": "3.17.0",
    "three": "0.178.0"
  }
}
